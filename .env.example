cat > .env.example <<'EOF'
# Database
DATABASE_URL=postgresql://rie_user:rie_password@localhost:5432/rie_db

# Application
ENVIRONMENT=development
EOF
# Database
DATABASE_URL=postgresql://rie_user:rie_password@localhost:5432/rie_db

# Application
ENVIRONMENT=development

# Background jobs
REDIS_URL=redis://localhost:6379/0

# Copy to .env (gitignored) and fill in.
# JWT signing key for Spec §10.1 auth. Must be >=32 random chars in production.
# Generate with: head -c 48 /dev/urandom | base64
RIE_JWT_SECRET=
LLM_API_KEY=
