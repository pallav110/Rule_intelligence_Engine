cat > .env.example <<'EOF'
# Database
DATABASE_URL=postgresql://rie_user:rie_password@localhost:5432/rie_db

# Application
ENVIRONMENT=development
EOF
# Database
DATABASE_URL=postgresql://rie_user:rie_password@localhost:5432/rie_db

# Application
ENVIRONMENT=development

# Background jobs
REDIS_URL=redis://localhost:6379/0

# Copy to .env (gitignored) and fill in.
# JWT signing key for Spec §10.1 auth. Must be >=32 random chars in production.
# Generate with: head -c 48 /dev/urandom | base64
RIE_JWT_SECRET=
LLM_API_KEY=

# Background training/evaluation — single flag, default off (stub/contract-check).
# false (default): train/eval Celery jobs validate dataset_version_id/ACTIVE → completed (no GPU, no model overwrite).
# true:            same jobs call rie_ml/scripts/training/* and rie_ml/scripts/evaluation/* with the real entrypoints.
RIE_ENABLE_REAL_TRAINING=false

# Spec §10.10 Observability
# Sentry DSN for error tracking (opt-in). Set to enable Sentry integration.
RIE_SENTRY_DSN=
SENTRY_DSN=
# Structured JSON logging: set to "json" to emit JSON log lines.
RIE_LOG_FORMAT=
# Grafana admin credentials (optional, defaults to admin/admin).
GF_ADMIN_USER=
GF_ADMIN_PASSWORD=
# Enable Prometheus scrape service in docker-compose (optional).
RIE_PROMETHEUS_ENABLED=true
