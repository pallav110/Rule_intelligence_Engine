# Large model checkpoints - exclude to avoid repo bloat
rie_ml/models/*/checkpoints/*.pt
rie_ml/models/bert_candidate/
rie_ml/models/roberta_candidate/

# But track metadata, configs, and evaluation results
!rie_ml/models/*/calibration_params.json
!rie_ml/models/*/calibration_results.json
!rie_ml/models/*/training_history.json
!rie_ml/models/*/promotion_decision.json
!rie_ml/models/model_comparison_report.json
!rie_ml/models/registry/
rie_ml/models/*/checkpoints/*.pt

# Generated datasets - rebuild with scripts/generate_dataset.py (or dataset_generation/run_pipeline.py)
rie_ml/dataset_generation/output/
rie_ml/datasets/extraction_bio/
rie_ml/datasets/evaluation/
rie_ml/datasets/validation_report.json
