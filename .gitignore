# But track metadata, configs, and evaluation results
!rie_ml/models/*/calibration_params.json
!rie_ml/models/*/calibration_results.json
!rie_ml/models/*/training_history.json
!rie_ml/models/*/promotion_decision.json
!rie_ml/models/model_comparison_report.json
!rie_ml/models/registry/
