{"feedback_id": "CS_FB029", "domain": "customer_support", "domain_pack_version": "customer_support_v0.1.0", "rule_family_id": "RF029", "feedback_text": "The expected closed ticket count should exclude duplicate cases.", "feedback_type": "business_rule_correction", "rule_category": "expected_result_correction", "is_actionable": true, "requires_clarification": false, "schema_context": {"available_tables": ["tickets"], "available_columns": ["tickets.is_duplicate", "tickets.status"]}, "rules": [{"business_term": "closed_ticket", "operation": "exclude", "conditions": [{"field": "tickets.is_duplicate", "operator": "equals", "value": true}], "scope": "global", "time_window": null, "threshold": null, "affected_entities": {"tables": ["tickets"], "columns": ["tickets.is_duplicate", "tickets.status"]}}], "annotation_version": "ann_v0.1.0", "source": "manual"}
