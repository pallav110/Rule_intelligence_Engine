        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, method, route) (rate(rie_http_request_duration_seconds_bucket[5m])))",
          "interval": "",
          "legendFormat": "{{method}} {{route}} median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(rie_http_request_duration_seconds_bucket[5m])))",
          "interval": "",
          "legendFormat": "{{method}} {{route}} p95",
          "refId": "B"
        }
      ],
      "title": "HTTP Request Duration (median / p95)",
      "type": "timeseries"
